rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all collections for any visitor
    match /{document=**} {
      allow read: if true;
    }

    // Allow write access to all collections for authenticated admins
    match /{document=**} {
      allow write: if request.auth != null;
    }

    // Allow public creation of submissions/bookings/newsletters without authentication
    match /contacts/{id} {
      allow create: if true;
    }
    match /bookings/{id} {
      allow create: if true;
    }
    match /enquiries/{id} {
      allow create: if true;
    }
    match /newsletter/{id} {
      allow create: if true;
    }
    match /payments/{id} {
      allow create: if true;
    }
  }
}